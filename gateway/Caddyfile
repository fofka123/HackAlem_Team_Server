:80 {
    encode zstd gzip

    handle /healthz {
        respond "ok" 200
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy {$FRONTEND_UPSTREAM:frontend:80}
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
